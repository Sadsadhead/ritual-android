<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_light_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="РАСПИСАНИЕ  ›"
        android:textColor="#676B64"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_schedule_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Сегодня"
        android:textColor="#171916"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_schedule_row_1"
        style="@style/WidgetScheduleRow"
        android:layout_marginTop="9dp" />

    <TextView
        android:id="@+id/widget_schedule_row_2"
        style="@style/WidgetScheduleRow" />

    <TextView
        android:id="@+id/widget_schedule_row_3"
        style="@style/WidgetScheduleRow" />
</LinearLayout>
